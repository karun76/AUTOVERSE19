
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AUTOVERSE | World of Cars</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#090b10;color:#f4f4f4;font-family:Arial,sans-serif}
:root{--gold:#d6b45d;--panel:#151922;--muted:#a7adba}
header{padding:24px 6%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #262b35;position:sticky;top:0;background:#090b10;z-index:10}
.logo{font-size:25px;font-weight:900;letter-spacing:3px;color:var(--gold)}
nav{display:flex;gap:20px;flex-wrap:wrap}
nav a{color:#eee;text-decoration:none;font-size:14px}
.hero{min-height:350px;padding:70px 6%;background:linear-gradient(110deg,#080a0e,#222935,#090b10);display:flex;flex-direction:column;justify-content:center}
.hero small{color:var(--gold);letter-spacing:4px}
.hero h1{font-size:clamp(35px,6vw,65px);margin:20px 0}
.hero p{color:#c3c7d0;max-width:600px;line-height:1.7}
.btn{padding:12px 18px;background:var(--gold);color:#080808;border:none;border-radius:5px;font-weight:bold;cursor:pointer}
.btn.secondary{background:#252a34;color:white;border:1px solid #4a4f59}
.section{padding:35px 6%}
.section-title{font-size:25px;margin-bottom:20px}
.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}
input,select{background:#171c25;color:white;border:1px solid #333b48;border-radius:6px;padding:12px}
#search{flex:1;min-width:220px}
.catalog{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:17px}
.card{background:var(--panel);border:1px solid #252c37;border-radius:10px;overflow:hidden;transition:.2s}
.card:hover{transform:translateY(-4px);border-color:var(--gold)}
.card-image{height:150px;background:linear-gradient(135deg,#202833,#101319);display:flex;align-items:center;justify-content:center;font-size:70px}
.card-content{padding:16px}
.card h3{margin:8px 0}
.card p{color:var(--muted);font-size:13px;line-height:1.6}
.tag{font-size:11px;color:var(--gold);margin-bottom:8px;display:block}
.specs{display:flex;gap:12px;flex-wrap:wrap;margin:12px 0;font-size:12px;color:#ddd}
.card-actions{display:flex;gap:8px;margin-top:12px}
.card-actions button{flex:1}
.brand-list{display:flex;gap:10px;flex-wrap:wrap}
.brand-btn{background:#1a2029;color:white;border:1px solid #323b48;padding:10px 15px;border-radius:25px;cursor:pointer}
.brand-btn.active,.brand-btn:hover{background:var(--gold);color:black}
.compare-box{background:var(--panel);padding:18px;border-radius:10px;margin-top:15px}
.compare-table{overflow-x:auto}
table{width:100%;border-collapse:collapse;margin-top:10px}
td,th{padding:12px;text-align:left;border-bottom:1px solid #303642}
th{color:var(--gold)}
.studio{display:grid;grid-template-columns:1.5fr 1fr;gap:20px}
.viewer{background:#111722;border-radius:12px;min-height:420px;position:relative;overflow:hidden;border:1px solid #2b3340}
#threeview{width:100%;height:420px}
.viewer-label{position:absolute;top:15px;left:15px;background:#0008;padding:8px;border-radius:5px}
.controls{background:var(--panel);padding:20px;border-radius:12px}
.controls label{display:block;margin:15px 0 8px;color:#ccc}
.controls input,.controls select{width:100%}
.color-options{display:flex;gap:10px;margin-top:10px}
.color-options button{width:35px;height:35px;border-radius:50%;border:2px solid white;cursor:pointer}
.sound-panel{margin-top:20px;background:#202630;padding:16px;border-radius:8px}
.sound-panel button{margin:5px}
footer{text-align:center;padding:30px;color:#888;border-top:1px solid #252b35}
.modal{display:none;position:fixed;inset:0;background:#000c;z-index:20;align-items:center;justify-content:center;padding:20px}
.modal-content{background:#161b24;padding:25px;border-radius:12px;max-width:600px;width:100%;max-height:85vh;overflow:auto}
.modal-content p{line-height:1.8;color:#ccc;margin:12px 0}
.close{float:right;cursor:pointer;color:var(--gold);font-size:25px}
@media(max-width:750px){.studio{grid-template-columns:1fr}header{flex-direction:column;gap:15px}.hero{padding:45px 6%}}
</style>
</head>

<body>

<header>
<div class="logo">AUTOVERSE</div>
<nav>
<a href="#catalog">Catalog</a>
<a href="#compare">Compare</a>
<a href="#studio">3D Studio</a>
</nav>
</header>

<section class="hero">
<small>THE WORLD OF AUTOMOBILES</small>
