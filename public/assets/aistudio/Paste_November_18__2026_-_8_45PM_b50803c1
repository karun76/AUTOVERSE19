<option value="name">Name A-Z</option>
<option value="power">Highest horsepower</option>
</select>
</div>

<div class="catalog" id="carGrid"></div>
</section>

<section class="section" id="compare">
<h2 class="section-title">Compare Cars</h2>
<p style="color:#aaa">Select Compare on any car card. You can compare up to three vehicles.</p>
<div class="compare-box">
<div id="compareTable">No cars selected.</div>
<button class="btn secondary" onclick="clearCompare()">Clear comparison</button>
</div>
</section>

<section class="section" id="studio">
<h2 class="section-title">3D Customization Studio</h2>

<div class="studio">
<div class="viewer">
<div class="viewer-label">Interactive 3D Vehicle · Drag to rotate</div>
<div id="threeview"></div>
</div>

<div class="controls">
<h3>Customize Your Vehicle</h3>

<label>Select car</label>
<select id="studioCar" onchange="updateStudioCar()"></select>

<label>Paint color</label>
<input type="color" id="paint" value="#c60022" onchange="changePaint(this.value)">

<div class="color-options">
<button style="background:#c60022" onclick="changePaint('#c60022')"></button>
<button style="background:#e5e5e5" onclick="changePaint('#e5e5e5')"></button>
<button style="background:#111111" onclick="changePaint('#111111')"></button>
<button style="background:#173e83" onclick="changePaint('#173e83')"></button>
<button style="background:#d6b45d" onclick="changePaint('#d6b45d')"></button>
<button style="background:#19804b" onclick="changePaint('#19804b')"></button>
</div>

<label>Wheel style</label>
<select id="wheelStyle" onchange="changeWheels()">
<option value="normal">Standard</option>
<option value="sport">Sport</option>
<option value="luxury">Luxury</option>
</select>

<label>Ride height (simulation)</label>
<input type="range" min="0" max="100" value="50" oninput="changeHeight(this.value)">

<label>Modification sound simulation</label>
<div class="sound-panel">
<button class="btn" onclick="startEngine()">Start Sound</button>
<button class="btn secondary" onclick="revEngine()">Rev</button>
<button class="btn secondary" onclick="stopEngine()">Stop</button>
<label>Simulated RPM</label>
<input type="range" min="800" max="7000" value="1200" id="rpm" oninput="setRPM(this.value)">
<p id="soundStatus" style="font-size:12px;color:#aaa;margin-top:10px">
Synthetic sound demonstration. Not an authentic vehicle recording.
</p>
</div>

</div>
</div>
</section>

<div class="modal" id="modal">
<div class="modal-content">
<span class="close" onclick="closeModal()">×</span>
<div id="modalBody"></div>
</div>
</div>

<footer>
AUTOVERSE © 2026 | Interactive Automobile Explorer
</footer>

