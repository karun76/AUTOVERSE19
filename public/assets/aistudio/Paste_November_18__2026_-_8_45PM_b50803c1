/* BRAND FILTERS */

const brands = ["All",...new Set(cars.map(c=>c.brand))];
let currentBrand = "All";
let compareList = [];

const brandBox = document.getElementById("brands");

brands.forEach(brand=>{
const button = document.createElement("button");
button.className="brand-btn";
button.textContent=brand;
button.onclick=()=>{
currentBrand=brand;
document.querySelectorAll(".brand-btn").forEach(b=>b.classList.remove("active"));
button.classList.add("active");
renderCars();
};
brandBox.appendChild(button);
});

brandBox.firstChild.classList.add("active");

/* CATALOG DISPLAY */

function renderCars(){

let list=cars.filter(car=>{
const search=document.getElementById("search").value.toLowerCase();
const type=document.getElementById("typeFilter").value;

const matchBrand=currentBrand==="All"||car.brand===currentBrand;
const matchSearch=(car.brand+" "+car.model+" "+car.type+" "+car.engine).toLowerCase().includes(search);
const matchType=!type||car.type.includes(type);

return matchBrand&&matchSearch&&matchType;
});

const sort=document.getElementById("sort").value;
if(sort==="name")list.sort((a,b)=>a.model.localeCompare(b.model));
if(sort==="power")list.sort((a,b)=>b.hp-a.hp);

const grid=document.getElementById("carGrid");

grid.innerHTML=list.map(car=>`
<div class="card">
<div class="card-image">🏎️</div>
<div class="card-content">
<span class="tag">${car.brand} · ${car.year}</span>
<h3>${car.model}</h3>
<p>${car.description}</p>
<div class="specs">
<span>${car.hp} HP</span>
<span>${car.acc}</span>
<span>${car.top} km/h</span>
</div>
<div class="card-actions">
<button class="btn" onclick="showDetails('${car.model}')">Details</button>
<button class="btn secondary" onclick="addCompare('${car.model}')">Compare</button>
</div>
</div>
`).join("");

if(list.length===0)grid.innerHTML="<p>No vehicles found.</p>";

}

renderCars();

/* DETAILS MODAL */

function showDetails(model){

const car=cars.find(c=>c.model===model);

document.getElementById("modalBody").innerHTML=`
<h2 style="color:var(--gold)">${car.brand} ${car.model}</h2>
<p>${car.description}</p>
<table>
<tr><th>Specification</th><th>Details</th></tr>
<tr><td>Year</td><td>${car.year}</td></tr>
<tr><td>Category</td><td>${car.type}</td></tr>
<tr><td>Engine</td><td>${car.engine}</td></tr>
<tr><td>Fuel</td><td>${car.fuel}</td></tr>
<tr><td>Horsepower</td><td>${car.hp} HP</td></tr>
<tr><td>Torque</td><td>${car.torque} Nm</td></tr>
<tr><td>Top speed</td><td>${car.top} km/h</td></tr>
<tr><td>Acceleration</td><td>${car.acc}</td></tr>
<tr><td>Price</td><td>${car.price}</td></tr>
</table>
`;

document.getElementById("modal").style.display="flex";
}

function closeModal(){
document.getElementById("modal").style.display="none";
}

/* COMPARISON */

function addCompare(model){

const car=cars.find(c=>c.model===model);

if(compareList.some(c=>c.model===model)){
alert("Already added!");
return;
}

if(compareList.length>=3){
alert("You can compare up to 3 cars.");
return;
}

compareList.push(car);
renderCompare();
}

function clearCompare(){
compareList=[];
renderCompare();
}

function renderCompare(){

const area=document.getElementById("compareTable");

if(compareList.length===0){
area.innerHTML="No cars selected.";
return;
}

let html="<div class='compare-table'><table><tr><th>Specification</th>";

compareList.forEach(car=>html+=`<th>${car.brand}<br>${car.model}</th>`);

html+="</tr>";

const rows=[
["Horsepower",c=>c.hp+" HP"],
["Torque",c=>c.torque+" Nm"],
["Top Speed",c=>c.top+" km/h"],
["Acceleration",c=>c.acc],
["Engine",c=>c.engine],
["Fuel",c=>c.fuel],
["Price",c=>c.price]
];

rows.forEach(row=>{
html+=`<tr><td>${row[0]}</td>`;
compareList.forEach(car=>html+=`<td>${row[1](car)}</td>`);
html+="</tr>";
});

html+="</table></div>";
area.innerHTML=html;
}

/* STUDIO SELECT */

const studioSelect=document.getElementById("studioCar");

cars.forEach(car=>{
const option=document.createElement("option");
option.value=car.model;
option.textContent=car.brand+" "+car.model;
studioSelect.appendChild(option);
});

/* THREE.JS SIMPLE CAR MODEL */

let scene,camera,renderer,carBody,wheels=[],cabin,paintMaterial;
let wheelStyle="normal";

async function init3D(){

const THREE=await import("https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js");

scene=new THREE.Scene();
scene.background=new THREE.Color("#111722");

camera=new THREE.PerspectiveCamera(45,1,0.1,100);
camera.position.set(6,4,7);
camera.lookAt(0,0,0);

renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setPixelRatio(window.devicePixelRatio);
renderer.setSize(document.getElementById("threeview").clientWidth,420);
renderer.shadowMap.enabled=true;

document.getElementById("threeview").appendChild(renderer.domElement);

const ambient=new THREE.HemisphereLight(0xffffff,0x333344,2);
scene.add(ambient);

const light=new THREE.DirectionalLight(0xffffff,3);
light.position.set(5,8,5);
scene.add(light);

const ground=new THREE.Mesh(
new THREE.PlaneGeometry(200,200),
new THREE.MeshStandardMaterial({color:0x20242b})
);
ground.rotation.x=-Math.PI/2;
ground.position.y=-0.65;
scene.add(ground);

const group=new THREE.Group();
scene.add(group);

paintMaterial=new THREE.MeshStandardMaterial({
color:0xc60022,
metalness:0.6,
roughness:0.25
});

carBody=new THREE.Mesh(
new THREE.BoxGeometry(4,0.65,1.8),
paintMaterial
);
carBody.position.y=0;
group.add(carBody);

cabin=new THREE.Mesh(
new THREE.BoxGeometry(2,0.8,1.5),
new THREE.MeshStandardMaterial({color:0x222c3b,metalness:0.4,roughness:0.2})
);
cabin.position.set(-0.3,0.65,0);
group.add(cabin);

const wheelMaterial=new THREE.MeshStandardMaterial({color:0x111111});
const rimMaterial=new THREE.MeshStandardMaterial({color:0x999999,metalness:0.8});

wheels=[];

for(let x of [-1.3,1.3]){
for(let z of [-1,1]){

const tire=new THREE.Mesh(
new THREE.CylinderGeometry(0.48,0.48,0.3,32),
wheelMaterial
);
tire.rotation.x=Math.PI/2;
tire.position.set(x,-0.35,z);
group.add(tire);

const rim=new THREE.Mesh(
new THREE.CylinderGeometry(0.27,0.27,0.32,24),
rimMaterial
);
rim.rotation.x=Math.PI/2;
rim.position.set(x,-0.35,z);
group.add(rim);

wheels.push({tire,rim,x,z});
}
}

const spoiler=new THREE.Mesh(
new THREE.BoxGeometry(0.12,0.1,1.8),
paintMaterial
);
spoiler.position.set(-1.9,0.65,0);
group.add(spoiler);

const frontLights=new THREE.Mesh(
new THREE.BoxGeometry(0.12,0.18,1.3),
new THREE.MeshStandardMaterial({color:0xffffff,emissive:0x888888})
);
frontLights.position.set(2,0.15,0);
group.add(frontLights);

const backLights=new THREE.Mesh(
new THREE.BoxGeometry(0.12,0.18,1.3),
new THREE.MeshStandardMaterial({color:0xff0000,emissive:0x440000})
);
backLights.position.set(-2,0.15,0);
group.add(backLights);

let dragging=false,lastX=0,lastY=0;

renderer.domElement.addEventListener("pointerdown",e=>{
dragging=true;
lastX=e.clientX;
lastY=e.clientY;
});

renderer.domElement.addEventListener("pointerup",()=>dragging=false);
renderer.domElement.addEventListener("pointerleave",()=>dragging=false);

renderer.domElement.addEventListener("pointermove",e=>{
if(!dragging)return;
group.rotation.y+=(e.clientX-lastX)*0.01;
group.rotation.x+=(e.clientY-lastY)*0.005;
lastX=e.clientX;
lastY=e.clientY;
});

renderer.domElement.addEventListener("wheel",e=>{
camera.position.multiplyScalar(e.deltaY>0?1.1:0.9);
camera.position.clampLength(4,15);
});

function animate(){
requestAnimationFrame(animate);
renderer.render(scene,camera);
}
animate();

window.addEventListener("resize",()=>{
const el=document.getElementById("threeview");
camera.aspect=el.clientWidth/420;
camera.updateProjectionMatrix();
renderer.setSize(el.clientWidth,420);
});

}

init3D();

function changePaint(color){
document.getElementById("paint").value=color;
if(paintMaterial)paintMaterial.color.set(color);
}

function changeWheels(){
wheelStyle=document.getElementById("wheelStyle").value;

if(!wheels.length)return;

wheels.forEach(w=>{
if(wheelStyle==="sport"){
w.rim.material.color.set("#d6b45d");
}else if(wheelStyle==="luxury"){
w.rim.material.color.set("#eeeeee");
}else{
w.rim.material.color.set("#999999");
}
});
}

function changeHeight(value){
if(!carBody)return;
carBody.position.y=(value-50)/500;
}

function updateStudioCar(){
const selected=cars.find(c=>c.model===studioSelect.value);
document.getElementById("soundStatus").innerText=
"Selected: "+selected.brand+" "+selected.model+
" | Sound is simulated, not authentic.";
}

/* SIMULATED SOUND */

let audioContext,oscillator,gain,filter;

function setupAudio(){

if(!audioContext){
audioContext=new(window.AudioContext||window.webkitAudioContext)();
oscillator=audioContext.createOscillator();
gain=audioContext.createGain();
filter=audioContext.createBiquadFilter();

oscillator.type="sawtooth";
filter.type="lowpass";
filter.frequency.value=400;
gain.gain.value=0;

oscillator.connect(filter);
filter.connect(gain);
gain.connect(audioContext.destination);
oscillator.start();
}

if(audioContext.state==="suspended")audioContext.resume();

}

function startEngine(){
setupAudio();
gain.gain.setTargetAtTime(0.05,audioContext.currentTime,0.1);
setRPM(document.getElementById("rpm").value);
document.getElementById("soundStatus").innerText="Simulated engine running.";
}

function setRPM(value){

if(!audioContext)return;

const rpm=Number(value);
oscillator.frequency.setTargetAtTime(rpm/20,audioContext.currentTime,0.05);
filter.frequency.setTargetAtTime(300+rpm/5,audioContext.currentTime,0.05);
}

function revEngine(){
setupAudio();
gain.gain.setTargetAtTime(0.06,audioContext.currentTime,0.05);
setRPM(6000);
document.getElementById("rpm").value=6000;
document.getElementById("soundStatus").innerText="Simulated revving sound.";
}

function stopEngine(){
if(!audioContext)return;
gain.gain.setTargetAtTime(0,audioContext.currentTime,0.1);
document.getElementById("soundStatus").innerText="Sound stopped.";
}

</script>

