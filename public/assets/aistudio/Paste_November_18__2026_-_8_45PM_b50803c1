<br>
<div>
<button class="btn" onclick="document.getElementById('catalog').scrollIntoView()">Explore Cars</button>
<button class="btn secondary" onclick="document.getElementById('studio').scrollIntoView()">Enter 3D Studio</button>
</div>
</section>

<section class="section" id="catalog">
<h2 class="section-title">Global Car Catalog</h2>

<div class="brand-list" id="brands"></div>

<div class="toolbar">
<input id="search" placeholder="Search brand, model, type..." oninput="renderCars()">
<select id="typeFilter" onchange="renderCars()">
<option value="">All categories</option>
<option>SUV</option>
<option>Sedan</option>
<option>Sports Car</option>
<option>Supercar</option>
<option>Hypercar</option>
<option>Electric</option>
<option>Coupe</option>
<option>Roadster</option>
</select>
<select id="sort" onchange="renderCars()">
